{
  "name": "@memaraio/wizard",
  "version": "1.0.1",
  "description": "Install Memara MCP server and memory skill for Cursor, Claude Code, and Claude Desktop",
  "type": "module",
  "bin": {
    "memara-wizard": "./dist/cli.js",
    "wizard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:assets",
    "build:ts": "rimraf dist && tsc",
    "build:assets": "node scripts/copy-assets.mjs",
    "test": "node --import tsx --test src/**/*.test.ts",
    "verify:pack": "node scripts/verify-pack.mjs",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "skill:pack": "node scripts/build-public-skill-zip.mjs",
    "docker:start": "./scripts/docker-wizard.sh start",
    "docker:stop": "./scripts/docker-wizard.sh stop",
    "docker:build": "./scripts/docker-wizard.sh build",
    "docker:dev": "./scripts/docker-wizard.sh dev",
    "docker:ci": "./scripts/docker-wizard.sh ci",
    "docker:pack": "./scripts/docker-wizard.sh pack",
    "docker:publish": "./scripts/docker-wizard.sh publish",
    "docker:publish-release": "./scripts/docker-wizard.sh publish-release",
    "docker:github-sync": "./scripts/docker-wizard.sh github-sync",
    "docker:github-tag": "./scripts/docker-wizard.sh github-tag",
    "docker:github-verify-pat": "./scripts/docker-wizard.sh github-verify-pat"
  },
  "keywords": [
    "memara",
    "mcp",
    "cursor",
    "claude",
    "memory",
    "ai",
    "wizard"
  ],
  "license": "MIT",
  "homepage": "https://memara.io/wizard",
  "author": {
    "name": "Memara Team",
    "email": "support@memara.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/memaraio/wizard.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^13.1.0",
    "posthog-node": "^4.18.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
